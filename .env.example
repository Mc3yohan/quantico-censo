# Quantico Censo — Environment Template (Local / Docker Demo)
# Copy to .env and replace placeholder secrets before production use.

APP_NAME="Quantico Censo"
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 15 + PostGIS 3.3
POSTGRES_USER=quantico_censo
POSTGRES_PASSWORD=change_me_local_dev_password_2026
POSTGRES_DB=quantico_censo_db
DATABASE_URL=postgresql+psycopg://quantico_censo:change_me_local_dev_password_2026@database:5432/quantico_censo_db

# Redis 7 (Cache-aside + CQRS WebSocket Pub/Sub + WS Tickets)
REDIS_URL=redis://redis:6379/0

# Auth & Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace_with_at_least_32_char_random_secret_key_for_dev
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS & WebSocket Origins (comma-separated)
CORS_ORIGINS=http://localhost:8095,http://127.0.0.1:8095,http://localhost:5173
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Media & Upload Limits
MEDIA_ROOT=/app/media_storage
MAX_PHOTO_BYTES=5242880
MAX_CSV_IMPORT_BYTES=10485760

# CQRS Node Role (sync | read | all)
SERVER_ROLE=all
AUTO_SEED_DEMO=true
